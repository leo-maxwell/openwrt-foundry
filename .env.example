# Public test configuration. Replace credentials, both SSH keys, and site settings before deployment.
# Copy to a private .env (mode 0600). For Actions, store its text in FIRMWARE_ENV.
# Use one NAME=value per line. The first = separates the name from its value.
# Enter scalar values literally, including spaces, #, $, and any further = signs.
# Put comments on separate lines. Use single-line JSON arrays for lists.

# System and access
# Single DNS label.
SYSTEM_HOSTNAME=r4s-example
# IANA time zone for all schedules and log dates.
SYSTEM_TIMEZONE=Australia/Adelaide
# LuCI language code supported by the image.
SYSTEM_LANGUAGE=en
# Nonempty list of NTP hosts or IP addresses, e.g. ["ntp.example.org"].
SYSTEM_NTP_SERVERS=["0.openwrt.pool.ntp.org", "1.openwrt.pool.ntp.org"]
# JSON array of complete OpenSSH public keys, one string per key.
SSH_AUTHORIZED_KEYS=["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIHf7F/vWQlQXaYneMapyyex7Wtzyy38Ml/HS6NMvoEPp example-admin"]

# LAN and WAN
# Router's IPv4 address including its subnet prefix length.
LAN_IPV4_CIDR=192.168.1.1/24
# Offset from the subnet's network address to the first DHCP lease.
LAN_DHCP_START=100
# Number of lease addresses. Keep the pool inside the subnet and clear of the router.
LAN_DHCP_LIMIT=100
# Physical OpenWrt interface used for PPPoE before VLAN tagging.
WAN_INTERFACE=eth0
# Optional VLAN ID (1–4094). Leave blank for untagged PPPoE.
WAN_VLAN_ID=100

# DNS and IPv6
# Use [] for ISP DNS, or list the IP addresses of all desired upstream resolvers.
DNS_SERVERS=["1.1.1.1","1.0.0.1"]
# Optional WAN prefix-length hint in bits (1–64). Blank means no preference.
IPV6_WAN_PD_REQUEST_LENGTH=56
# Preferred prefix length per downstream router (1–64 bits). Allow a separate LAN /64.
IPV6_DOWNSTREAM_PD_LENGTH=60

# USB storage and logging
# Filesystem UUID of the ext4 log volume.
USB_UUID=37c40a21-463f-451b-9145-a2febd821dc7
# Comma-separated mount options.
USB_MOUNT_OPTIONS=noatime,errors=remount-ro
# Daily rotation time in local 24-hour HH:mm.
LOG_ROTATION_TIME=03:00
# Least severe priority to retain: emerg, alert, crit, err, warning, notice, info, debug.
LOG_LEVEL=info
# Minimum free space in bytes. Logs may use the rest of the volume.
LOG_RESERVE_BYTES=1000000000

# Scheduled reboot
# Set to true or false. When false, the other reboot settings are ignored.
REBOOT_ENABLED=false
# Required when enabled: daily or weekly.
REBOOT_FREQUENCY=weekly
# Required when enabled: local 24-hour HH:mm.
REBOOT_TIME=04:00
# Weekly only: mon, tue, wed, thu, fri, sat, sun. Ignored for daily reboots.
REBOOT_DAY_OF_WEEK=sun

# Private credentials
# Exact ISP account name.
PPPOE_USERNAME=router@example.net
# Exact ISP password, including any spaces or punctuation.
PPPOE_PASSWORD=password
# Complete OpenWrt-compatible shadow password hash, including its leading $.
ADMIN_PASSWORD_HASH=$6$exampleR4S$2f1YK8LfOf3q7XavwZ4VE8fvidqLWX8t5ClK5SG0Hn4HSOe93SmjlYCzRPO9rq5D3w0oihiuSV8.eM/5s6xz6/
# Base64 of the complete router SSH host private key file, on one line.
SSH_HOST_PRIVATE_KEY_B64=AAAAC3NzaC1lZDI1NTE5AAAAQFHLPFWD0s2+BQ3+a2HeUjA61l0mHmemOP0ODBj2e4SIm9Mh05xcOucDtO+mHp1GmueSFCKOTQRu/ZRFf/dx6xI=
